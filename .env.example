# ───────────────────────────────────────────────────────────
# BidBox — runtime configuration
# Copy to .env and adjust. Every variable has a sensible default
# so the demo runs without any configuration.
# ───────────────────────────────────────────────────────────

# --- LLM provider (provider-agnostic — any OpenAI-compatible endpoint) ---

# OpenAI / Qwen via ModelScope / local Llama etc.
# Leave OPENAI_API_KEY blank to run in STUB mode (deterministic canned
# responses — useful for offline demos and tests).
#
# DEFAULT: Qwen2.5-72B-Instruct via ModelScope (open-weights model)
# The challenge brief requires "one full task on an open-weights model".
# Procurement data often cannot leave the country — Qwen via ModelScope
# is the recommended path; for fully on-prem, use Ollama running Qwen2.5.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-72B-Instruct

# Alternative: OpenAI gpt-4o-mini (frontier model — for side-by-side comparison)
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Alternative: local Llama via Ollama (fully on-prem)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1:8b

# --- Storage ---

# SQLite database path. Defaults to ./bidbox.db in the cwd.
BIDBOX_DB_PATH=./bidbox.db

# --- MCP server ---

# Transport: "stdio" (default — for CLI/IDE integration) or "sse" (for HTTP).
MCP_TRANSPORT=stdio
MCP_SSE_HOST=127.0.0.1
MCP_SSE_PORT=8765

# --- Review UI (FastAPI) ---

REVIEW_UI_HOST=127.0.0.1
REVIEW_UI_PORT=8000

# --- Human-in-the-loop ---

# The principal ID that identifies the procurement officer.
# In production, this comes from OIDC. For the demo, hardcode.
OFFICER_PRINCIPAL_ID=officer-demo
OFFICER_PRINCIPAL_KIND=human

# --- Citation validator ---

# Minimum cosine similarity (embedding) between a claim and the cited
# paragraph for the citation to count as "supportive". Range: 0.0 - 1.0.
CITATION_MIN_SIMILARITY=0.75

# --- Logging ---

LOG_LEVEL=INFO
